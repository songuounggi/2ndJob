# 생성물 -- scripts/build_planner.py 로 언제든 다시 뽑는다.
# output/ 를 통째로 무시하면 git 이 그 안으로 들어가지 않아 예외가 먹지
# 않는다. output/* 로 적어야 아래 ! 가 동작한다.
output/*
src/

# 예외: 올릴 핀 이미지는 다른 PC 로 따라가야 한다. 다시 뽑으려면 PDF
# 빌드부터 페이지 렌더까지 사슬이 길고, 6장에 850KB 뿐이다.
# output 은 상품별(prod1/prod2/prod3, 2026-09-25). 안쪽 폴더를 예외로 열려면
# 한 단계씩 연다: prod1 을 열고, 그 안을 다시 닫고, 필요한 것만 연다.
!output/prod1/
output/prod1/*
!output/prod1/pinterest_v815/
# Etsy 에 올린 리스팅 이미지도 같은 이유. 소스인 rail_strip_v815.png 를
# 만든 방법이 기록에 없어 다른 PC 에서 다시 뽑을 수 없다(2026-09-24).
!output/prod1/listing_v815/

# 리스팅 · 핀 이미지 최종본은 PC 사이를 따라가게 (2026-10-03 사용자: "맨땅에서 다시 만드는 것보다 받아서 고치는 게 낫다").
# 어차피 Etsy · 핀터레스트에 공개되는 그림이다. 옛 시안(draft 묶음)은 올리지 않는다 -- 상품 3 listing 만 318MB.
# PDF 는 git 에 넣지 않는다(판마다 통째로 역사에 쌓이고 되돌릴 수 없다) -- 저장소가 비공개가 된 뒤 GitHub Releases 로.
!output/prod2/
output/prod2/*
!output/prod2/listing_student/
!output/prod3/
output/prod3/*
!output/prod3/upload/
output/prod3/upload/*
!output/prod3/upload/listing-images-v0.55/
!output/prod3/upload/listing-images-v0.56/
!output/prod3/upload/listing-images-v0.60/
!output/prod4/
output/prod4/*
!output/prod4/listing/
output/prod4/listing/*
!output/prod4/listing/draft-v0.6/
!output/prod4/pinterest/
output/prod4/pinterest/*
!output/prod4/pinterest/draft-v0.2/

# 검수용 임시 렌더
scratch_*.png

# 캐시
__pycache__/
*.pyc

# 검수하며 만든 임시 파일. 지우지는 않되 추적하지 않는다.
# 이것들이 git status 를 가려서 한 번은 git add -A 로 다른 방의
# 작업까지 쓸어담은 적이 있다.
scratchpad_*
dom_tmp.html
# 시안 폴더 안 _pages = 판매 PDF 쪽을 그대로 렌더한 그림 -- 저장소가 공개라 올리지 않는다(빌드 뒤 시안 스크립트가 다시 만든다)
output/prod4/listing/draft-v0.6/_pages/
output/prod4/pinterest/draft-v0.2/_pages/
